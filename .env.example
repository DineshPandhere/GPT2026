# Supabase API (Create a free project at https://supabase.com)
# 1. Obtain Project URL and anon public key from Project Settings > API
# 2. Never expose service_role private key here!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Organizer Admin Access Passcode
# Used to view registered participants list securely from the admin portal
VITE_ORGANIZER_PIN=GPT2026

# Optional Organizer Contact Details (Displayed in footer if provided)
VITE_ORGANIZER_PHONE=
VITE_ORGANIZER_EMAIL=
